# Vite API Configuration
# Local Development: http://localhost:8000/api
# Production: Your Render backend URL (e.g., https://relio-api.onrender.com/api)
VITE_API_URL=http://localhost:8000/api

# Cloudinary Setup (For direct frontend uploads if applicable, otherwise backend handles this)
VITE_CLOUDINARY_URL=https://api.cloudinary.com/v1_1/your_cloud_name/image/upload
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name
